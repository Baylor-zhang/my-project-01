#为保证会话保存可以复用，这里可以将会话保存到文件的函数定义到函数中，后面通过调用这个函数来保存会话到文件中
def save_session():
    # 1.保存当前会话信息
    if st.session_state.current_session:
        # 构建新的会话对象
        session_data = {
            "nick_name": st.session_state.nick_name,
            "nature": st.session_state.nature,
            "current_session": st.session_state.current_session,
            "messages": st.session_state.messages
        }
        # 创建一个文件夹保存会话信息，如果文件夹不存在，自动创建一个文件夹
        if not os.path.exists("sessions"):
            os.mkdir("sessions")
        # 在文件夹下创建文件，保存会话
        with open(f"sessions/{st.session_state.current_session}.json", "w", encoding="utf-8") as f:
            json.dump(session_data, f, ensure_ascii=False, indent=2)
#生成会话标识的函数
def generate_session_name():
    return datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
#加载所有的历史会话信息
def load_session_list():
    session_list = []
    #加载sessions文件夹下面有多少个json文件
    if os.path.exists("sessions"):  #判断sessions目录文件是否存在
        file_list = os.listdir("sessions")      #os.listdir罗列指定目录下面的文件，并存在file_list中
        for filename in file_list:      #获取所有文件列表
            if filename.endswith(".json"):
#                filename[:-5]   #获取文件名
                session_list.append(filename[:-5]) #将截取的文件名添加到session_list中
    session_list.sort(reverse=True) #对会话列表进行倒序排序
    return session_list

#加载指定会话信息
def load_session(session_name):
    try:
        if os.path.exists(f"sessions/{session_name}.json"):  #判断会话数据是否存在
        #如果存在读取会话数据
            with open(f"sessions/{session_name}.json","r",encoding="utf-8") as f:
            #将json中的文件数据读取出来，并封装到session_data对象中
                session_data = json.load(f)
                st.session_state.messages=session_data["messages"]  #将会话信息存储到st.session_state.messages 对象中
                st.session_state.nick_name = session_data["nick_name"]
                st.session_state.current_session = session_data["current_session"]
    except Exception as e:
        print(e)
        st.error("会话数据加载失败")
#删除会话信息
def delete_session(session_name):
    try:
        if os.path.exists(f"sessions/{session_name}.json"):
            os.remove(f"sessions/{session_name}.json")
            #如果删除的是当前会话，则需要更新消息列表
            if session_name == st.session_state.current_session:
                #重置消息列表
                st.session_state.messages = []
                #生成新的会话标识
                st.session_state.current_session = generate_session_name()

    except Exception:
        st.error("删除会话失败")

