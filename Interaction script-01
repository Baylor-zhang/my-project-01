# 案例 基于面向对象的编程思想完成如下系统开发
#
# 某社区图书馆需要开发一个简单的图书管理系统。系统需要支持会员登录、图书借阅、图书归还等功能。系统中有两种类型的会员:普通会员和VIP会员，他们的借书权限不同。你需要使用面向对象编程的思想，设计并实现这个图书管理系统。
# 核心功能:
# 1.会员登录:会员通过卡号和密码登录系统
# 2.借书:会员可以借阅库存中有余量的图书
# 3.还书:会员可以归还借阅的图书
# 4.查看我的借阅:展示当前会员已经借阅的图书列表
# 5.退出系统
# 借阅规则:
# 1.普通会员最多可借3本
# 2.VIP会员最多可借6+VIP等级本(VIP等级，默认为1)
# 注意:
# 1.登录成功(卡号和密码均正确)后，才可以访问该系统
# 2.图书库存不足，或当前会员借书数量达到最大借书数量，不能再借新书
from abc import ABC,abstractmethod
import json
#书籍类
class Book:
    #初始化方法
    def __init__(self,book_id,title,author,total_num):
        self.book_id = book_id  #书籍编号
        self.title = title  #书籍标题
        self.author = author    #书籍作者
        self.total_num = total_num  #总数量
        self.__avaiable_num = total_num #可借阅的书籍数量，默认为总数量，但是这个值不用对客户暴露，我们设置为私有方法
    #设置借书和还书的方法
    def borrow_book(self):
        if self.__avaiable_num > 0:
            self.__avaiable_num -= 1
            print(f'借阅成功，还剩{self.__avaiable_num}本可借')
        else:
            print('借阅失败，库存不足')
    def return_book(self):
        self.__avaiable_num += 1
        print(f'还书成功，还剩{self.__avaiable_num}本可借')

    def get_available_num(self):    #获取当前可借阅的图书数量
        return self.__avaiable_num
#抽象类：只能被继承，不能被直接实例化的类，作用，规定子类必须实现某些方法，强制子类必须遵守统一的代码规范
#python中的抽象类，需要继承abc模块中的ABC类，--->ABC:Abstract Base Class,需要提前导入 from abc import ABC

#会员类
class Member(ABC):
    def __init__(self,member_id,password,name):
        self.member_id = member_id  #会员卡号
        self.__password = password  #密码,作为个人隐私信息，就不向外暴露了，所以设置为私有方法
        self.name = name    #会员姓名
        self.__borrowed_books = []  #借阅书籍列表
    def borrow_book(self,book: Book):   #会员借书方法,并调用Book 类
        #判断当前会员是否已超过最大借阅书本数量
        if len(self.__borrowed_books) >= self.get_max_books():
            print('借阅失败，已超过最大借阅数量')
            return False
        #判断书籍是否可以借阅
        if book.get_available_num() > 0:
            book.borrow_book()
            self.__borrowed_books.append(book)
            print(f'{self.name}借阅{book.title}成功，还剩{book.get_available_num()}本可借')
            return True
        else:
            print('借阅失败，库存不足')
            return False
    def return_book(self,book: Book):
        if book in self.__borrowed_books:
            self.__borrowed_books.remove(book)
            book.return_book()
            print(f'{self.name}还书{book.title}成功，还剩{book.get_available_num()}本可借')
        else:
            print('还书失败，您没有借阅此书')

    #获取当前会员可借阅的图书数量(需要在子类中实现) #->int表示会返回一个整数
    @abstractmethod     #表示下面的方法需要强制在子类中实现，否则会报错
    def get_max_books(self) ->int:
        pass

    #获取会员密码
    def get_password(self):
        return self.__password
    #获取会员已借阅的图书列表
    def get_borrowed_books(self):
        return self.__borrowed_books

#定义两个会员子类，一个是普通会员，一个是VIP会员
class NormalMember(Member):
    def get_max_books(self)->int:   #因为普通会员与VIP会员的已借阅的图书列表不同，所以需要重写该方法
        return 3
#定义VIP会员
class VIPMember(Member):
    def __init__(self,member_id,password,name,vip_level):
        super().__init__(member_id,password,name)
        self.vip_level = vip_level  #会员等级
    def get_max_books(self)->int: #重写可以已借阅的图书列表的方法
        return 6 + self.vip_level
#图书馆管理系统类
class LibrarySystem:
    def __init__(self):
        self.books = {} #图书列表{"AI001":Book对象，"AI002":Book对象}
        self.members = {}  #会员列表 {"N001":Member对象,"N002":Member对象}
        self.current_member: Member|None = None  #当前登录的会员类型为Member类型或者None类型
        #加载数据(书籍数据和会员数据)
        self.load_books_data()
        self.load_members_data()
    #在json文件中加载书本数据和会员数据
    def load_books_data(self):
        #加载books.json文件
        with open("./resource/books.json","r",encoding="utf-8") as f:
            books_data = json.load(f) #读取文件内容
            #因为json中的数据是列表，所以需要遍历列表，将列表中的数据转换为Book对象
            #book是字典，self.books[book["编号"]]是字典中的key,Book()对象是字典中的值
            for book in books_data:
                self.books[book["编号"]] = Book(book["编号"],book["标题"],book["作者"],book["数量"])
            print("书籍数据加载成功！")
    def load_members_data(self):
        with open("./resource/members.json","r",encoding="utf-8") as f:
            members_data = json.load(f)
            for member in members_data:
                if member["卡号"].startswith("N"):
                    self.members[member["卡号"]] = NormalMember(member["卡号"],member["密码"],member["姓名"])
                elif member["卡号"].startswith("V"):
                    self.members[member["卡号"]] = VIPMember(member["卡号"],member["密码"],member["姓名"],member["会员等级"])
            print("会员数据加载成功！")
    def login(self): #登录
        while True:
            print("\n【登录】")
            member_id = input("请输入会员卡号：")
            password = input("请输入密码：")
            # 判断会员卡号是否存在
            if member_id not in self.members:
                print("会员卡号不存在！")
                continue

            # 判断密码是否正确
            if self.members[member_id].get_password() == password:
                print(f"登录成功，欢迎您! {self.members[member_id].name}")
                self.current_member = self.members[member_id]
                return True
            else:
                print("密码错误！")
                continue
    def borrow_book(self):
        #1.展示当前图书馆图书列表
        for book in self.books.values():
            print(f"编号:{book.book_id} 标题:{book.title} 作者:{book.author} 数量:{book.get_available_num()}")
        #2.获取用户输入的图书编号，执行借书操作
        book_id = input("请输入要借阅的图书编号：")
        if book_id not in self.books:
            print("图书编号不存在！")
            return
        self.current_member.borrow_book(self.books[book_id])
    def return_book(self):
        #展示当前会员的借阅图书列表
        borrowed_books = self.current_member.get_borrowed_books()
        for book in borrowed_books:
            print("【已借阅的图书列表：】")
            print(f"编号:{book.book_id} 标题:{book.title} 作者:{book.author}")

        book_id = input("请输入要归还的图书编号：")
        if book_id not in self.books:
            print("图书编号不存在！")
            return
        self.current_member.return_book(self.books[book_id])
    #查看当前借阅的图书列表
    def show_borrowed_books(self):
        borrowed_books = self.current_member.get_borrowed_books()
        if len(borrowed_books) == 0:
            print("您没有借阅任何图书！")
        else:
            print("【已借阅的图书列表：】")
            for book in borrowed_books:
                print(f"编号:{book.book_id} 标题:{book.title} 作者:{book.author}")

    def run(self):      #登录之后的菜单
        if self.login():    #如果login方法的返回值为True，则表示登录成功
            while True:
                print("\n1.借阅图书")
                print("2.归还图书")
                print("3.查看借阅")
                print("4.退出系统")
                choice = input("请输入您的选择项：(1-4)")
                match choice:
                    case "1":
                        self.borrow_book()
                    case "2":
                        self.return_book()
                    case "3":
                        self.show_borrowed_books()
                    case "4":
                        print("退出系统")
                        break
                    case _:
                        print("无效的选择项！")

if  __name__ == '__main__':
    ls = LibrarySystem()
    ls.run()
